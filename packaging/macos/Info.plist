<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key><string>VerkzChat</string>
    <key>CFBundleDisplayName</key><string>VerkzChat</string>
    <!-- Keep the installed app identity across the rename. -->
    <key>CFBundleIdentifier</key><string>br.com.verkzcompany.VerkzChat</string>
    <key>CFBundleExecutable</key><string>verkzchat</string>
    <key>CFBundleIconFile</key><string>verkzchat</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>__VERSION__</string>
    <key>CFBundleVersion</key><string>__VERSION__</string>
    <key>LSMinimumSystemVersion</key><string>11.0</string>
    <key>LSApplicationCategoryType</key><string>public.app-category.social-networking</string>
    <key>NSHighResolutionCapable</key><true/>
    <!-- Draw on whichever GPU drives the screen on dual-GPU Intel Macs; without it a
         forced switch to the integrated GPU leaves windows blank until a relaunch. -->
    <key>NSSupportsAutomaticGraphicsSwitching</key><true/>
    <key>NSMicrophoneUsageDescription</key><string>VerkzChat uses the microphone for calls and for the voice messages you choose to send.</string>
    <key>NSCameraUsageDescription</key><string>VerkzChat uses the camera for the video calls you make and answer.</string>
    <key>NSHumanReadableCopyright</key><string>© 2026 VERKZ. Não afiliado ao WhatsApp nem à Meta.</string>
</dict>
</plist>
